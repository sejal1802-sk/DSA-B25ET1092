2. Palindrome 

#include <stdio.h>

int main()
{
    char str[100];
    int i, j, len = 0, flag = 0;

    printf("Enter string: ");
    scanf("%s", str);

    while(str[len] != '\0')
        len++;

    for(i = 0, j = len - 1; i < j; i++, j--)
    {
        if(str[i] != str[j])
        {
            flag = 1;
            break;
        }
    }

    if(flag == 0)
        printf("String is Palindrome");
    else
        printf("String is Not Palindrome");

    return 0;
}
 
