4. Copy a String 

#include <stdio.h>

int main()
{
    char str[100], copy[100];
    int i;

    printf("Enter string: ");
    scanf("%s", str);

    for(i = 0; str[i] != '\0'; i++)
    {
        copy[i] = str[i];
    }

    copy[i] = '\0';

    printf("Copied string: %s", copy);

    return 0;
}

OUTPUT:
Enter string: MMCOE
Copied string: MMCOE
