#include <stdio.h>

int main()
{
    char str[100];
    int start, length, i;

    printf("Enter string: ");
    scanf("%s", str);

    printf("Enter starting position: ");
    scanf("%d", &start);

    printf("Enter length: ");
    scanf("%d", &length);

    printf("Substring: ");

    for(i = start; i < start + length; i++)
    {
        printf("%c", str[i]);
    }

    return 0;
}
 
OUTPUT : 

Enter string: SEJAL
Enter starting position: 2
Enter length: 3
Substring: JAL
